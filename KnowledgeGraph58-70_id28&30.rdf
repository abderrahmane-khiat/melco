        <rdfs:label>Road</rdfs:label>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#RoadCondition -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#RoadCondition">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#ControlData"/>
    </owl:Class>
    


