    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#isRoadSegmentOf -->

    <owl:ObjectProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#isRoadSegmentOf"/>
    


