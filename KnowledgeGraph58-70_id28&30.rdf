    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Sensor">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#MyAutonomousCarPart"/>
