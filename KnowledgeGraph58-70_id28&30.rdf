    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#RoadSurfaceMarking -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#RoadSurfaceMarking">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#TrafficSign"/>
        <rdfs:comment>A traffic sign painted on the road.</rdfs:comment>
        <rdfs:label>pavement marking information</rdfs:label>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#RoadType -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#RoadType">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#TransportInfrastructureData"/>
        <rdfs:comment>A road serving a specific purpose and imposing restrictions on the usage.</rdfs:comment>
        <rdfs:comment>Information about the path towards the goal that is currently being driven.</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#RoadVerge -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#RoadVerge">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#OtherThoroughfare"/>
