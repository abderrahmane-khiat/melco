        <rdfs:subPropertyOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#idSignal"/>
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#TrafficSignal"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>Identification number of the Traffic Signal</rdfs:comment>
        <rdfs:label>signal_no</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#isEmpty -->

    <owl:DatatypeProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#isEmpty">
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Lane"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Obstacles Or Objects are on Road (no) otherwise (yes)</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#laneChgFG -->

    <owl:DatatypeProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#laneChgFG">
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Lane"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>Lane change possible / impossible. 0: yes 1: no</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#laneType -->

    <owl:DatatypeProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#laneType">
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Lane"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>Lane type. 0: Straight lane 1: Left turn lane 2: Right turn lane</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#length -->

    <owl:DatatypeProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#length">
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Arrow"/>
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#CrosswalkSegment"/>
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#ZebraCrossing"/>
        <rdfs:range rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#mm"/>
    </owl:DatatypeProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#nodePos -->

    <owl:DatatypeProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#nodePos">
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Node"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>represent the position of a node</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#pathSegmentID -->

    <owl:DatatypeProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#pathSegmentID">
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#PathSegment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>index ID of a path segment</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#pos -->

    <owl:DatatypeProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#pos">
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Position"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#poslat -->

    <owl:DatatypeProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#poslat">
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#LateralPosition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#rearOverhang -->

    <owl:DatatypeProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#rearOverhang">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Vehicle"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>rear overhang are the lengths of a road vehicle which extend beyond the wheelbase at the rear.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#signal_col -->

    <owl:DatatypeProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#signal_col">
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#SignalState"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#signal_state -->

    <owl:DatatypeProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#signal_state">
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#SignalState"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>categories of color lights for traffic signal (0 for red and yellow, 1 for green and 2 for Unknown)</rdfs:comment>
        <rdfs:label>signal_state</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#spatioTemporalEvent.Timestamp -->

    <owl:DatatypeProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#spatioTemporalEvent.Timestamp">
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#SpatioTemporalEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
    </owl:DatatypeProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#speedMax -->

    <owl:DatatypeProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#speedMax">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Lane"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Legal speed allowed on particular lane.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#steerAngle -->

    <owl:DatatypeProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#steerAngle">
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Steering"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>The value of steering angle which is defined as the angle between the front of the vehicle and the steered wheel direction to change car direction</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#timeStamp -->

    <owl:DatatypeProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#timeStamp">
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#FrontPosition"/>
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Position"/>
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#RearPosition"/>
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#SignalState"/>
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#SpeedProfile"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
    </owl:DatatypeProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#transportInfrastructureData.Timestamp -->

    <owl:DatatypeProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#transportInfrastructureData.Timestamp">
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#TransportInfrastructureData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
    </owl:DatatypeProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#vehicleHeight -->

    <owl:DatatypeProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#vehicleHeight">
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Vehicle"/>
        <rdfs:range rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#mm"/>
        <rdfs:comment>is the distance between a flat, level surface, and the highest part of the car</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#vehicleID -->

    <owl:DatatypeProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#vehicleID">
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Vehicle"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>is the identification number of the car</rdfs:comment>
        <rdfs:label>NO</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#vehicleLength -->

    <owl:DatatypeProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#vehicleLength">
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Vehicle"/>
        <rdfs:range rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#mm"/>
        <rdfs:comment>is the distance from the back to the front of the car</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#vehicleModel -->

    <owl:DatatypeProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#vehicleModel">
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Vehicle"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>describe the model of the car e.g. BMW X3</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#vehtype -->

    <owl:DatatypeProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#vehtype">
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Vehicle"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#weatherData.Timestamp -->

    <owl:DatatypeProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#weatherData.Timestamp">
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#WeatherData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
    </owl:DatatypeProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#wheelBase -->

    <owl:DatatypeProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#wheelBase">
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#FrontWheel"/>
        <rdfs:range rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#mm"/>
        <rdfs:comment>the wheelbase is the distance between the centers of the front and rear wheels</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#x_at_pos -->

    <owl:DatatypeProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#x_at_pos">
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Signal"/>
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#TurnPoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#y_at_pos -->

    <owl:DatatypeProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#y_at_pos">
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Signal"/>
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#TurnPoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#altitude? -->

    <owl:DatatypeProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#altitude?">
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#TrafficSignal"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#angle? -->

    <owl:DatatypeProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#angle?">
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#TrafficSignal"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#latitude? -->

    <owl:DatatypeProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#latitude?">
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#TrafficSignal"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#longitude? -->

    <owl:DatatypeProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#longitude?">
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#TrafficSignal"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#road/linkSecID -->

    <owl:DatatypeProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#road/linkSecID">
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Lane"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>Road section ID. Road section ID 0 is used for sections inside the intersection. Adjacent lanes usually have the same section ID .</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/VehicleOnto#throttle? -->

    <owl:DatatypeProperty rdf:about="https://fraunhofer.mitsubishi/melco/VehicleOnto#throttle?">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Engine"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>number of throttle body</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2006/time#Interval -->

    <owl:Class rdf:about="http://www.w3.org/2006/time#Interval">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
    </owl:Class>
    


    <!-- http://www.w3.org/2006/time#TemporalEntity -->

    <owl:Class rdf:about="http://www.w3.org/2006/time#TemporalEntity">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#TimeData?"/>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Accelarate -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Accelarate">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#DrivingAction"/>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Adult -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Adult">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Pedestrian"/>
        <rdfs:comment>An adult pedestrian moving around the cityscape.</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Animal -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Animal">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Obstacle"/>
        <rdfs:comment>All animals, e.g. cats, rats, dogs, deer, birds.</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#ApproachingParameter -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#ApproachingParameter">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#SpatioTemporalEventParameter"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#hasValue"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">5</owl:minQualifiedCardinality>
                        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#hasValue"/>
                        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">50</owl:maxQualifiedCardinality>
                        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#ArchitecturalStructure -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#ArchitecturalStructure">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#SurroundingObject"/>
        <rdfs:comment>Construction with stationary contact to the ground</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Arrow -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Arrow">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#RegulatorySurfaceSign"/>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Automobile -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Automobile">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Vehicle"/>
        <rdfs:comment>road vehicle powered by a motor</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#AutomobilePart -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#AutomobilePart">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#VehiclePart"/>
        <rdfs:comment>Refers to parts and devices installed in the car</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Barrier -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Barrier">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Obstacle"/>
        <rdfs:comment>Any metal, concrete or water barrier temporarily placed in the scene in order to re-direct vehicle or pedestrian traffic.</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Bendy -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Bendy">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Bus"/>
        <rdfs:comment>Buses and shuttles designed to carry more than 10 people and comprises two or more rigid sections linked by a pivoting joint</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Bicycle -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Bicycle">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Vehicle"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#vehtype"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int">600</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Human or electric powered 2-wheeled vehicle designed to travel at lower speeds either on road surface, sidewalks or bicycle paths.</rdfs:comment>
        <rdfs:label>Bike</rdfs:label>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#BicycleRack -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#BicycleRack">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#ObjectonRoad"/>
        <rdfs:comment>Area or device intended to park or secure the bicycles in a row. It includes all the bicycles parked in it and any empty slots that are intended for parking bicycles</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#BikePath -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#BikePath">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#OtherThoroughfare"/>
        <rdfs:comment>A lane for bycicles. Might be a seperated lane or included into another road segment.</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Brake -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Brake">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#DrivingAction"/>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Building -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Building">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Place"/>
        <rdfs:comment>A place with a construction.</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Bus -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Bus">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Automobile"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#vehtype"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int">300</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>large road vehicle for transporting people</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#BusesOnlySign -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#BusesOnlySign">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#MandatorySign"/>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Camera -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Camera">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Sensor"/>
        <rdfs:comment>optical device for recording/transmitting images or videos, used to detect obstacles</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Car -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Car">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Automobile"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#vehtype"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int">100</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Vehicle designed primarily for personal use, e.g. sedans, hatch-backs, wagons, vans, mini-vans, SUVs and jeeps.</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Carriageway -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Carriageway">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Road"/>
        <rdfs:comment>A road without any planned obstacles.</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Child -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Child">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Pedestrian"/>
        <rdfs:comment>A child pedestrian moving around the cityscape.</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#CollisionWarning -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#CollisionWarning">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Warning"/>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#ConstructionAgent -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#ConstructionAgent">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Pedestrian"/>
        <rdfs:comment>A human in the scene whose main purpose is construction work.</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#ConstructionCar -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#ConstructionCar">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Automobile"/>
        <rdfs:comment>Vehicles primarily designed for construction. Typically very slow moving or stationary.</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#ControlData -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#ControlData"/>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#CrosswalkSegment -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#CrosswalkSegment">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#RoadSegment"/>
        <rdfs:comment>Part of the road that pedestrians use for crossing it.</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#CurrentLaneSafeDist -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#CurrentLaneSafeDist">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#RoadCondition"/>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#DashedLine -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#DashedLine">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#RegulatorySurfaceSign"/>
        <rdfs:comment>A dashed line to signal the right of ways.</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Decelarate -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Decelarate">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#DrivingAction"/>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#DirectionRoadSign -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#DirectionRoadSign">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#IndicationSign"/>
        <rdfs:comment>A traffic sign encoding different directions for navigation.</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#DrivingAction -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#DrivingAction">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Motion"/>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#DualCarriageway -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#DualCarriageway">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Carriageway"/>
        <rdfs:comment>A carriage way with multiple lanes per direction.</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#EndLane -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#EndLane">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#LaneSegment"/>
        <rdfs:comment>start and end GPS positions of a path</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#EndNode -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#EndNode">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Node"/>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Engine -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Engine">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#AutomobilePart"/>
        <rdfs:comment>machine designed to produce mechanical energy from another form of energy</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#FrontPosition -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#FrontPosition">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Position"/>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#FrontWheel -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#FrontWheel">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Wheel"/>
        <rdfs:comment>The wheel in the front of the vehicle</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#GPS -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#GPS">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Sensor"/>
        <rdfs:comment>Global Positioning System, is a satellite-based radionavigation system</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#GPSTrack -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#GPSTrack">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Path"/>
        <rdfs:comment>tracking the vehicle movements and determine its location.</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#GoBackward -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#GoBackward">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#DrivingAction"/>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#GoRoundabout -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#GoRoundabout">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#DrivingAction"/>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#GoStraight -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#GoStraight">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#DrivingAction"/>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Green -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Green">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#SignalState"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#signal_col"/>
                <owl:hasValue>green</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#signal_state"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#GreenGo -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#GreenGo">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#TrafficSignalControl"/>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Guardrail -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Guardrail">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#ObjectonRoad"/>
        <rdfs:comment>Guardrails next to or within roads to prevent cars from leaving the track.</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Highway -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Highway">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#RoadType"/>
        <rdfs:comment>A road linked to a set of exceptions to general roads enabling higher travelling speeds.</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Human -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Human">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Obstacle"/>
        <rdfs:comment>Any humanoid shaped Object.</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#IndicationSign -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#IndicationSign">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#RoadSign"/>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#InstructionSurfaceSign -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#InstructionSurfaceSign">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#RoadSurfaceMarking"/>
        <rdfs:comment>Any traffic sign instructing a certain driving behaviour.</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Intersection -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Intersection">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Junction"/>
        <rdfs:comment>A junction with two roads directly crossing.</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#IntersectionSegment -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#IntersectionSegment">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#PathSegment"/>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Junction -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Junction">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#RoadPart"/>
        <rdfs:comment>Any possibility to switch roads.</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Lane -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Lane">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#RoadPart"/>
        <rdfs:comment>Is part of a roadway that is designated to be used by a single line of vehicles, to control and guide drivers and reduce traffic conflicts.</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#LaneChange -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#LaneChange">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#DrivingAction"/>
        <rdfs:comment>For example, a lane change to the left is possible if the
car which shall conduct the maneuver has a neighboring lane
on the left and has no car on the positions beside and in front
of it in the neighboring lane.</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#LaneSegment -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#LaneSegment">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#PathSegment"/>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#LateralPosition -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#LateralPosition">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Position"/>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#LeftEdgeOfLane -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#LeftEdgeOfLane">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#LateralPosition"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#poslat"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#float">1.0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#LeftLaneChange -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#LeftLaneChange">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#LaneChange"/>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#LeftSidewalk -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#LeftSidewalk">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Sidewalk"/>
        <rdfs:comment>Sidewalk on the left side.</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#LeftTurn -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#LeftTurn">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Turn"/>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Lidar -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Lidar">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Sensor"/>
        <rdfs:comment>A surveying method that measures distance to a target by illuminating the target with laser light and measuring the reflected light with a sensor.</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Local-ExpressLane -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Local-ExpressLane">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Carriageway"/>
        <rdfs:comment>A carriageway intendet for fast driving. Might impose a usage restriction.</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Man -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Man">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Pedestrian"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#vehtype"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int">510</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#MandatorySign -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#MandatorySign">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#RoadSign"/>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#MiddleOfLane -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#MiddleOfLane">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#LateralPosition"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#poslat"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.5</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Motion -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Motion">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#ControlData"/>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Motorcycle -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Motorcycle">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Vehicle"/>
        <rdfs:comment>Gasoline or electric powered 2-wheeled vehicle designed to move rapidly (at the speed of standard cars) on the road surface. This category includes all motorcycles, vespas and scooters.</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#MyAutonomousCar -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#MyAutonomousCar">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Automobile"/>
