        <rdfs:range rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#PathDirection"/>
    </owl:ObjectProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#isObservedAs -->

    <owl:ObjectProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#isObservedAs">
