        <rdfs:range rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Position"/>
    </owl:ObjectProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#hasRearPosition -->

    <owl:ObjectProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#hasRearPosition">
