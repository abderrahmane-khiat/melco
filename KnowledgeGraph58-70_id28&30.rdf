        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Road"/>
        <rdfs:range rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#TrafficConflict"/>
    </owl:ObjectProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#isOnLane -->

    <owl:ObjectProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#isOnLane">
