    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#RoadSegment -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#RoadSegment">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#RoadPart"/>
