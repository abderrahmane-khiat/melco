        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#isRoadSegmentOf"/>
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Road"/>
        <rdfs:range rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#RoadSegment"/>
    </owl:ObjectProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#hasRoadType -->

    <owl:ObjectProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#hasRoadType">
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Road"/>
        <rdfs:range rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#RoadType"/>
    </owl:ObjectProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#hasSpeedLimit -->

    <owl:ObjectProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#hasSpeedLimit">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Lane"/>
                    <rdf:Description rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Road"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#SpeedLimit"/>
    </owl:ObjectProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#hasSpeedProfile -->

    <owl:ObjectProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#hasSpeedProfile">
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Vehicle"/>
        <rdfs:range rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#SpeedProfile"/>
    </owl:ObjectProperty>
    


