        <rdfs:range rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Road"/>
    </owl:ObjectProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#isConnectedTo -->

    <owl:ObjectProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#isConnectedTo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Junction"/>
        <rdfs:range rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Road"/>
    </owl:ObjectProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#isLaneOf -->

    <owl:ObjectProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#isLaneOf"/>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#isLocatedOn -->

    <owl:ObjectProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#isLocatedOn">
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Signal"/>
        <rdfs:range rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Lane"/>
        <rdfs:range rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Road"/>
    </owl:ObjectProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#isNodeOf -->

    <owl:ObjectProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#isNodeOf">
