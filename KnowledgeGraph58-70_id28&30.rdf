        <rdfs:range rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#TrafficSignal"/>
    </owl:ObjectProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#isToReach -->

    <owl:ObjectProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#isToReach">
        <rdfs:domain rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#MyAutonomousCar"/>
        <rdfs:range rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Stopline"/>
