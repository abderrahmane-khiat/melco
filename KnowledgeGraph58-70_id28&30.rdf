    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#MyAutonomousCarPart -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#MyAutonomousCarPart">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#AutomobilePart"/>
        <rdfs:comment>Refers to parts, devices and sensors installed in the self-driving car</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#NationalRoad -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#NationalRoad">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#OrdinaryRoad"/>
        <rdfs:comment>An ordinary road with significant importance. Might be linked to a set of exceptions from general driving rules.</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Network -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Network">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#TransportInfrastructureData"/>
        <rdfs:label>Network</rdfs:label>
        <rdfs:label>Transport Network</rdfs:label>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Night -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Night">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#TimeofDay"/>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Node -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Node">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#PathDirection"/>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#ObjectonRoad -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#ObjectonRoad">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#ArchitecturalStructure"/>
        <rdfs:comment>Any construction whose geolocation is irrelevant for navigation.</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Obstacle -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Obstacle">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#SurroundingObject"/>
        <rdfs:comment>Any kind of Obstacle that has to be considered in the pathfinding process.</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#OneWayLane -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#OneWayLane">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Lane"/>
        <rdfs:comment>A lane which can only be used in one direction.</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#OnlyLineForTurn -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#OnlyLineForTurn">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#InstructionSurfaceSign"/>
