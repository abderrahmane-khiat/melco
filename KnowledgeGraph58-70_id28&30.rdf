        <rdfs:range rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Road"/>
    </owl:ObjectProperty>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#isOnTurn -->

    <owl:ObjectProperty rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#isOnTurn">
