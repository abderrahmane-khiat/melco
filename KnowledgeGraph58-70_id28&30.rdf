    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Trailer">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Vehicle"/>
        <rdfs:comment>Any vehicle trailer, both for trucks, cars and motorcycles (regardless of whether currently being towed or not).</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Train -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Train">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Vehicle"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#vehtype"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int">400</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#TransportInfrastructureData -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#TransportInfrastructureData"/>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Tree -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Tree">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#ObjectonRoad"/>
        <rdfs:comment>Any plant with considerable height that cannot be run over.</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Truck -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Truck">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Automobile"/>
        <rdfs:subClassOf>
            <owl:Restriction>
