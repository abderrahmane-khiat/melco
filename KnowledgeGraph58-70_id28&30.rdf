    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#SpatioTemporalEventAction -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#SpatioTemporalEventAction">
