    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#SideCollisionWarning -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#SideCollisionWarning">
