    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#RoadSign -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#RoadSign">
