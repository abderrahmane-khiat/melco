    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#StartNode -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#StartNode">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Node"/>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Steering -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Steering">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#AutomobilePart"/>
        <rdfs:comment>Type of steering control in vehicles</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Stop -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Stop">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#DrivingAction"/>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#StopSign -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#StopSign">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#PrioritySign"/>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Stopline -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Stopline">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#RegulatorySurfaceSign"/>
        <rdfs:comment>A line where a car has to be stopped.</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#StoppingParameter -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#StoppingParameter">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#SpatioTemporalEventParameter"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#hasValue"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#SurroundingObject -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#SurroundingObject">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#TransportInfrastructureData"/>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#TimeofDay -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#TimeofDay">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#Interval"/>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#TrafficConflict -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#TrafficConflict">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#TransportInfrastructureData"/>
        <rdfs:comment>A traffic conflict, is &quot;an observable event which would end in an accident unless one of the involved parties slows down, changes lanes, or accelerates to avoid collision</rdfs:comment>
        <rdfs:label>ConflictArea</rdfs:label>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#TrafficSign -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#TrafficSign">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Signal"/>
        <rdfs:comment>Traffic signs identified from sensor input.</rdfs:comment>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#TrafficSignal -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#TrafficSignal">
        <rdfs:subClassOf rdf:resource="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#Signal"/>
        <rdfs:comment>Any traffic signal with the ability to change its status.</rdfs:comment>
        <rdfs:label>signals3D</rdfs:label>
    </owl:Class>
    


    <!-- https://fraunhofer.mitsubishi/melco/TransportInfrastructure#TrafficSignalControl -->

    <owl:Class rdf:about="https://fraunhofer.mitsubishi/melco/TransportInfrastructure#TrafficSignalControl">
